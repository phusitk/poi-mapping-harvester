<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <%- include('partials/head', { title }) %>
</head>
<body class="h-full">

  <div class="flex min-h-full flex-col justify-center px-6 py-16 lg:px-8">
    <div class="sm:mx-auto sm:w-full sm:max-w-sm text-center">

      <p class="text-xs font-semibold uppercase tracking-widest text-gray-400">
        POI Mapping Platform
      </p>
      <h1 class="mt-4 text-2xl font-bold text-gray-900"><%= title %></h1>
      <p class="mt-3 text-sm text-gray-500"><%= message %></p>

      <a
        href="/dashboard"
        class="mt-8 inline-block rounded-md bg-blue-600 px-4 py-2 text-sm
               font-semibold text-white hover:bg-blue-700 transition-colors duration-150"
      >
        Back to dashboard
      </a>

    </div>
  </div>

</body>
</html>
